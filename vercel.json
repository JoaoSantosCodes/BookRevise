{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 },
    "api/queue.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/queue", "schedule": "*/5 * * * *" }
  ]
}
